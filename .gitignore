# VSCode 扩展项目 .gitignore

# 构建输出
out/
dist/
*.vsix
.worktree/

# 真宿主 e2e：@vscode/test-electron 下载的 VS Code（约 132MB，不入库）
.vscode-test/

# 真宿主 e2e 每次跑的结果（可再生成，不入库）
tests/e2e/vscode/artifacts/

# Node.js 依赖
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.pnpm-debug.log*

# 环境变量文件
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# 测试覆盖率报告
coverage/
.nyc_output
*.lcov
ci-test-report.json

# 运行时数据
pids
*.pid
*.seed
*.pid.lock

# 编译器/IDE 生成的文件
.vscode/settings.json
.vscode/tasks.json
.vscode/launch.json
.vscode/extensions.json
*.swp
*.swo
*~

# 操作系统生成的文件
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# 日志文件
logs
*.log

# TypeScript 编译缓存
*.tsbuildinfo

# ESLint 缓存
.eslintcache

# Webpack 构建缓存
.cache/

# 临时文件
tmp/
temp/
*.tmp
*.temp

# 备份文件
*.bak
*.backup
*~

# 压缩文件
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# 数据文件和测试输出（项目特定）
*.lac
*.csv
*.vcd
test_*
*_test.*
*_export.*
performance_*.csv
memory_*.csv
progress_*.csv

# Python 脚本生成的文件
__pycache__/
*.py[cod]
*$py.class
*.so

# 开发工具配置
.idea/
*.iml
*.ipr
*.iws

# Git 子模块
.gitmodules

# 编译的发布包
compiled-release-*/
*.tar.gz

# 本地配置文件
config.local.*
settings.local.*

# 调试文件
debug*.js
debug*.json

# 性能分析文件
*.cpuprofile
*.heapprofile

# Lock files (保留 package-lock.json，但排除其他)
yarn.lock
pnpm-lock.yaml

# 系统特定文件
*.lnk
.fuse_hidden*
.nfs*

# RecoveryManager 测试运行产物（2026-11-03）
# 历史上这里是 process.cwd()/.recovery-checkpoints，现已改到 os.tmpdir() 下按实例隔离，
# 但为防止回退，仍在此忽略。已有的 20 个历史文件已在 D-8 中移除。
.recovery-checkpoints/

# 固件源码与编译产物（用户 2026-11-04 裁定忽略）
# 为什么整目录忽略而不是只忽略构建产物：`logicanalyzer/` 是上游固件仓库的完整副本
# （C 源码 + CMake + .pio 构建目录，约 2.5G），本仓只作为"固件协议的唯一真值"供
# e2e 模拟器对照（见 tests/e2e/vscode/lib/mockDevice.cjs 的文件头引用）。
# ⇒ 它不是本仓的源码，不需要版本化；但**本地必须保留**，否则协议对照失去依据。
logicanalyzer/
